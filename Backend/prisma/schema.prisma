model StudentAcademicRollSectionStreamMapping {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  studentSlug String  @db.VarChar(50)
  student     Student @relation(fields: [studentSlug], references: [slug], onDelete: Cascade)

  sessionSlug String  @db.VarChar(50)
  session     Session @relation(fields: [sessionSlug], references: [slug], onDelete: Cascade)

  boardSlug String @db.VarChar(50)
  board     Board  @relation(fields: [boardSlug], references: [slug], onDelete: Cascade)

  classSlug String @db.VarChar(50)
  class     Class  @relation(fields: [classSlug], references: [slug], onDelete: Cascade)

  sectionSlug String?  @db.VarChar(50)
  section     Section? @relation(fields: [sectionSlug], references: [slug], onDelete: SetNull)

  streamSlug String? @db.VarChar(50)
  stream     Stream? @relation(fields: [streamSlug], references: [slug], onDelete: SetNull)

  rollNumberPrefix String? @db.VarChar(20)
  rollNumber       Int?

  academicStatus StudentAcademicStatus @default(CURRENT)

  academicStatusChangedAt DateTime?

  studentAttendances    StudentAttendance[]
  studentAttendanceDays StudentAttendanceDay[]
  studentAttendanceLogs StudentAttendanceLog[]

  previousPromotionMappings StudentPromotion[] @relation("PreviousAcademicMappingPromotion")
  newPromotionMappings      StudentPromotion[] @relation("NewAcademicMappingPromotion")

  periodicTestStudentMarks PeriodicTestStudentMark[]

  status    String    @default("active")
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  termExamStudentMarks      TermExamStudentMark[]
  topicWiseStudentGrades    TopicWiseStudentGrade[]
  coScholasticStudentGrades CoScholasticStudentGrade[]

  @@unique([schoolSlug, studentSlug, sessionSlug], map: "uq_student_session_mapping")
  @@index([schoolSlug], map: "idx_sarm_school")
  @@index([studentSlug], map: "idx_sarm_student")
  @@index([sessionSlug], map: "idx_sarm_session")
  @@index([boardSlug], map: "idx_sarm_board")
  @@index([classSlug], map: "idx_sarm_class")
  @@index([sectionSlug], map: "idx_sarm_section")
  @@index([streamSlug], map: "idx_sarm_stream")
  @@index([rollNumber], map: "idx_sarm_roll")
  @@index([academicStatus], map: "idx_sarm_academic_status")
  @@index([schoolSlug, sessionSlug, boardSlug, classSlug], map: "idx_sarm_class_filter")
  @@index([schoolSlug, sessionSlug, boardSlug, classSlug, sectionSlug], map: "idx_sarm_section_filter")
  @@index([schoolSlug, sessionSlug, boardSlug, classSlug, sectionSlug, rollNumber], map: "idx_sarm_roll_filter")
  @@map("student_academic_roll_section_stream_mappings")
}

// student attendance

model StudentAttendance {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  studentSlug String  @db.VarChar(50)
  student     Student @relation(fields: [studentSlug], references: [slug], onDelete: Cascade)

  sessionSlug String  @db.VarChar(50)
  session     Session @relation(fields: [sessionSlug], references: [slug], onDelete: Cascade)

  boardSlug String @db.VarChar(50)
  board     Board  @relation(fields: [boardSlug], references: [slug], onDelete: Cascade)

  classSlug String @db.VarChar(50)
  class     Class  @relation(fields: [classSlug], references: [slug], onDelete: Cascade)

  sectionSlug String?  @db.VarChar(50)
  section     Section? @relation(fields: [sectionSlug], references: [slug], onDelete: SetNull)

  streamSlug String? @db.VarChar(50)
  stream     Stream? @relation(fields: [streamSlug], references: [slug], onDelete: SetNull)

  academicMappingSlug String?                                  @db.VarChar(50)
  academicMapping     StudentAcademicRollSectionStreamMapping? @relation(fields: [academicMappingSlug], references: [slug], onDelete: SetNull)

