model StudentPromotion {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  batchSlug String @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  studentSlug String  @db.VarChar(50)
  student     Student @relation(fields: [studentSlug], references: [slug], onDelete: Cascade)

  previousAcademicMappingSlug String                                  @db.VarChar(50)
  previousAcademicMapping     StudentAcademicRollSectionStreamMapping @relation("PreviousAcademicMappingPromotion", fields: [previousAcademicMappingSlug], references: [slug], onDelete: Restrict)

  newAcademicMappingSlug String                                  @db.VarChar(50)
  newAcademicMapping     StudentAcademicRollSectionStreamMapping @relation("NewAcademicMappingPromotion", fields: [newAcademicMappingSlug], references: [slug], onDelete: Restrict)

  previousSessionSlug String  @db.VarChar(50)
  previousSession     Session @relation("PreviousPromotionSession", fields: [previousSessionSlug], references: [slug], onDelete: Restrict)

  previousBoardSlug String @db.VarChar(50)
  previousBoard     Board  @relation("PreviousPromotionBoard", fields: [previousBoardSlug], references: [slug], onDelete: Restrict)

  previousClassSlug String @db.VarChar(50)
  previousClass     Class  @relation("PreviousPromotionClass", fields: [previousClassSlug], references: [slug], onDelete: Restrict)

  previousSectionSlug String?  @db.VarChar(50)
  previousSection     Section? @relation("PreviousPromotionSection", fields: [previousSectionSlug], references: [slug], onDelete: SetNull)

  previousStreamSlug String? @db.VarChar(50)
