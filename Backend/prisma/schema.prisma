// leave request

enum HrmEmployeeLeaveCategory {
  FULL_DAY
  HALF_DAY
  MULTI_DAY
}

enum HrmEmployeeLeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum HrmEmployeeLeavePayType {
  PAID
  UNPAID
}

model HrmEmployeeLeaveRequest {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  employeeSlug String      @db.VarChar(50)
  employee     HrmEmployee @relation(fields: [employeeSlug], references: [slug], onDelete: Restrict)

  leaveTypeSlug String       @db.VarChar(50)
  leaveType     HrmLeaveType @relation(fields: [leaveTypeSlug], references: [slug], onDelete: Restrict)

  subject     String @db.VarChar(150)
  description String @db.VarChar(500)

  leaveCategory HrmEmployeeLeaveCategory

  fromDate DateTime  @db.Date
  toDate   DateTime? @db.Date

  totalDays Decimal @db.Decimal(6, 2)

  document     String? @db.VarChar(500)
  documentName String? @db.VarChar(255)

  requestStatus HrmEmployeeLeaveRequestStatus @default(PENDING)

  payType          HrmEmployeeLeavePayType?
  numberOfDaysPaid Decimal?                 @db.Decimal(6, 2)

  reply String? @db.VarChar(500)

  approvedBySlug String? @db.VarChar(50)
  approvedBy     User?   @relation("HrmEmployeeLeaveApprovedBy", fields: [approvedBySlug], references: [slug], onDelete: SetNull)

  approvedAt DateTime?

  rejectedBySlug String? @db.VarChar(50)
  rejectedBy     User?   @relation("HrmEmployeeLeaveRejectedBy", fields: [rejectedBySlug], references: [slug], onDelete: SetNull)

  rejectedAt DateTime?

  cancelledBySlug String? @db.VarChar(50)
  cancelledBy     User?   @relation("HrmEmployeeLeaveCancelledBy", fields: [cancelledBySlug], references: [slug], onDelete: SetNull)

  cancelledAt DateTime?

  status    String    @default("active") @db.VarChar(20)
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs                     HrmEmployeeLeaveRequestLog[]
  hrmEmployeeAttendances   HrmEmployeeAttendance[]
  hrmEmployeePayrollLeaves HrmEmployeePayrollLeave[]

  @@index([schoolSlug])
  @@index([employeeSlug])
  @@index([leaveTypeSlug])
  @@index([requestStatus])
  @@index([fromDate])
  @@index([toDate])
  @@index([isActive])
  @@map("hrm_employee_leave_requests")
}

model HrmEmployeeLeaveRequestLog {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  leaveRequestSlug String                  @db.VarChar(50)
  leaveRequest     HrmEmployeeLeaveRequest @relation(fields: [leaveRequestSlug], references: [slug], onDelete: Cascade)

  employeeSlug String      @db.VarChar(50)
  employee     HrmEmployee @relation(fields: [employeeSlug], references: [slug], onDelete: Restrict)

  action String @db.VarChar(50)

  previousStatus HrmEmployeeLeaveRequestStatus?
  newStatus      HrmEmployeeLeaveRequestStatus?

  payType          HrmEmployeeLeavePayType?
  numberOfDaysPaid Decimal?                 @db.Decimal(6, 2)

