// Exam Module

// Exam Type
model ExamType {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  examType    String
  description String?

  status    String    @default("active")
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  termExams                   TermExam[]
  termExamClassConfigurations TermExamClassConfiguration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolSlug, examType])
  @@map("exam_types")
}

model TermExam {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  sessionSlug String  @db.VarChar(50)
  session     Session @relation(fields: [sessionSlug], references: [slug], onDelete: Cascade)

  boardSlug String @db.VarChar(50)
  board     Board  @relation(fields: [boardSlug], references: [slug], onDelete: Cascade)

  examTypeSlug String   @db.VarChar(50)
  examType     ExamType @relation(fields: [examTypeSlug], references: [slug], onDelete: Restrict)

  examTitle String
  startDate DateTime
  endDate   DateTime

  examStatus String @default("scheduled")

  status    String    @default("active")
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  termExamClassConfigurations TermExamClassConfiguration[]

  @@unique([schoolSlug, sessionSlug, boardSlug, examTitle])
  @@index([schoolSlug], map: "idx_term_exam_school")
  @@index([sessionSlug], map: "idx_term_exam_session")
  @@index([boardSlug], map: "idx_term_exam_board")
  @@index([examTypeSlug], map: "idx_term_exam_type")
  @@map("term_exams")
}

model TermExamTimeTable {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  termExamClassConfigurationSlug String                     @db.VarChar(50)
  termExamClassConfiguration     TermExamClassConfiguration @relation(fields: [termExamClassConfigurationSlug], references: [slug], onDelete: Cascade)

  classSubjectSlug String            @db.VarChar(50)
  classSubject     AddSubjectToClass @relation(fields: [classSubjectSlug], references: [slug], onDelete: Cascade)

  streamSlug String?
  stream     Stream? @relation(fields: [streamSlug], references: [slug], onDelete: SetNull)

  studyMode String?

  maxMarks Decimal @db.Decimal(8, 2)
  minMarks Decimal @db.Decimal(8, 2)

  examDate      DateTime
  examTime      String   @db.VarChar(20)
  duration      Int
  questionPaper String?

  status    String    @default("active")
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolSlug, termExamClassConfigurationSlug, classSubjectSlug, streamSlug])
  @@index([schoolSlug], map: "idx_tett_school")
  @@index([termExamClassConfigurationSlug], map: "idx_tett_config")
  @@index([classSubjectSlug], map: "idx_tett_subject")
  @@index([streamSlug], map: "idx_tett_stream")
  @@map("term_exam_time_tables")
}

model TermExamClassConfiguration {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  termExamSlug String   @db.VarChar(50)
  termExam     TermExam @relation(fields: [termExamSlug], references: [slug], onDelete: Cascade)

  classSlug String @db.VarChar(50)
  class     Class  @relation(fields: [classSlug], references: [slug], onDelete: Cascade)

  publishResult Boolean @default(false)

  status    String    @default("active")
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  timeTables TermExamTimeTable[]
  examType   ExamType?           @relation(fields: [examTypeId], references: [id])
  examTypeId Int?

  @@unique([schoolSlug, termExamSlug, classSlug])
  @@index([schoolSlug], map: "idx_tecc_school")
  @@index([termExamSlug], map: "idx_tecc_exam")
  @@index([classSlug], map: "idx_tecc_class")
  @@map("term_exam_class_configurations")
}

