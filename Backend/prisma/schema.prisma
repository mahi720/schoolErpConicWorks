  @@index([schoolSlug], map: "idx_sarm_school")
  @@index([studentSlug], map: "idx_sarm_student")
  @@index([sessionSlug], map: "idx_sarm_session")
  @@index([boardSlug], map: "idx_sarm_board")
  @@index([classSlug], map: "idx_sarm_class")
  @@index([sectionSlug], map: "idx_sarm_section")
  @@index([streamSlug], map: "idx_sarm_stream")
  @@index([rollNumber], map: "idx_sarm_roll")
  @@index([academicStatus], map: "idx_sarm_academic_status")
