  updatedAt DateTime @updatedAt

  @@unique([schoolSlug, studentSlug, sessionSlug, year, month])
  @@index([schoolSlug, sessionSlug, boardSlug, classSlug, year, month])
  @@index([schoolSlug, sessionSlug, classSlug, sectionSlug, year, month])
  @@index([studentSlug, sessionSlug, year, month])
  @@index([academicMappingSlug])
  @@map("student_attendances")
