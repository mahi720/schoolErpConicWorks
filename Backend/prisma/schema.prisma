model StudentAcademicRollSectionStreamMapping {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  studentSlug String  @db.VarChar(50)
  student     Student @relation(fields: [studentSlug], references: [slug], onDelete: Cascade)

  sessionSlug String  @db.VarChar(50)
  session     Session @relation(fields: [sessionSlug], references: [slug], onDelete: Cascade)

  boardSlug String @db.VarChar(50)
  board     Board  @relation(fields: [boardSlug], references: [slug], onDelete: Cascade)

  classSlug String @db.VarChar(50)
  class     Class  @relation(fields: [classSlug], references: [slug], onDelete: Cascade)

  sectionSlug String?  @db.VarChar(50)
  section     Section? @relation(fields: [sectionSlug], references: [slug], onDelete: SetNull)

  streamSlug String? @db.VarChar(50)
  stream     Stream? @relation(fields: [streamSlug], references: [slug], onDelete: SetNull)

  rollNumberPrefix String? @db.VarChar(20)
  rollNumber       Int?

  academicStatus StudentAcademicStatus @default(CURRENT)

  academicStatusChangedAt DateTime?

  studentAttendances    StudentAttendance[]
  studentAttendanceDays StudentAttendanceDay[]
  studentAttendanceLogs StudentAttendanceLog[]

  previousPromotionMappings StudentPromotion[] @relation("PreviousAcademicMappingPromotion")
  newPromotionMappings      StudentPromotion[] @relation("NewAcademicMappingPromotion")

  periodicTestStudentMarks PeriodicTestStudentMark[]

  status    String    @default("active")
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  termExamStudentMarks      TermExamStudentMark[]
  topicWiseStudentGrades    TopicWiseStudentGrade[]
  coScholasticStudentGrades CoScholasticStudentGrade[]

  @@unique([schoolSlug, studentSlug, sessionSlug], map: "uq_student_session_mapping")
  @@index([schoolSlug], map: "idx_sarm_school")
  @@index([studentSlug], map: "idx_sarm_student")
  @@index([sessionSlug], map: "idx_sarm_session")
  @@index([boardSlug], map: "idx_sarm_board")
  @@index([classSlug], map: "idx_sarm_class")
  @@index([sectionSlug], map: "idx_sarm_section")
  @@index([streamSlug], map: "idx_sarm_stream")
  @@index([rollNumber], map: "idx_sarm_roll")
  @@index([academicStatus], map: "idx_sarm_academic_status")
  @@index([schoolSlug, sessionSlug, boardSlug, classSlug], map: "idx_sarm_class_filter")
  @@index([schoolSlug, sessionSlug, boardSlug, classSlug, sectionSlug], map: "idx_sarm_section_filter")
  @@index([schoolSlug, sessionSlug, boardSlug, classSlug, sectionSlug, rollNumber], map: "idx_sarm_roll_filter")
  @@map("student_academic_roll_section_stream_mappings")
}

// student attendance

model StudentAttendance {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  studentSlug String  @db.VarChar(50)
  student     Student @relation(fields: [studentSlug], references: [slug], onDelete: Cascade)

  sessionSlug String  @db.VarChar(50)
  session     Session @relation(fields: [sessionSlug], references: [slug], onDelete: Cascade)

  boardSlug String @db.VarChar(50)
  board     Board  @relation(fields: [boardSlug], references: [slug], onDelete: Cascade)

  classSlug String @db.VarChar(50)
  class     Class  @relation(fields: [classSlug], references: [slug], onDelete: Cascade)

  sectionSlug String?  @db.VarChar(50)
  section     Section? @relation(fields: [sectionSlug], references: [slug], onDelete: SetNull)

  streamSlug String? @db.VarChar(50)
  stream     Stream? @relation(fields: [streamSlug], references: [slug], onDelete: SetNull)

  academicMappingSlug String?                                  @db.VarChar(50)
  academicMapping     StudentAcademicRollSectionStreamMapping? @relation(fields: [academicMappingSlug], references: [slug], onDelete: SetNull)

  year  Int
  month Int

  /// Example:
  /// {
  ///   "01": "P",
  ///   "02": "A",
  ///   "03": "L"
  /// }
  attendance Json

  totalWorkingDays Int @default(0)
  totalPresent     Int @default(0)
  totalAbsent      Int @default(0)
  totalLeave       Int @default(0)
  totalHalfDay     Int @default(0)
  totalHoliday     Int @default(0)

  attendancePercentage Decimal @default(0) @db.Decimal(5, 2)

  attendanceDays StudentAttendanceDay[]
  attendanceLogs StudentAttendanceLog[]

  status    String    @default("active")
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolSlug, studentSlug, sessionSlug, year, month])
  @@index([schoolSlug, sessionSlug, boardSlug, classSlug, year, month])
  @@index([schoolSlug, sessionSlug, classSlug, sectionSlug, year, month])
  @@index([studentSlug, sessionSlug, year, month])
  @@index([academicMappingSlug])
  @@map("student_attendances")
}

model StudentAttendanceDay {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  attendanceSlug String            @db.VarChar(50)
  attendance     StudentAttendance @relation(fields: [attendanceSlug], references: [slug], onDelete: Cascade)

  studentSlug String  @db.VarChar(50)
  student     Student @relation(fields: [studentSlug], references: [slug], onDelete: Cascade)

  sessionSlug String  @db.VarChar(50)
  session     Session @relation(fields: [sessionSlug], references: [slug], onDelete: Cascade)

  boardSlug String @db.VarChar(50)
  board     Board  @relation(fields: [boardSlug], references: [slug], onDelete: Cascade)

  classSlug String @db.VarChar(50)
  class     Class  @relation(fields: [classSlug], references: [slug], onDelete: Cascade)

  sectionSlug String?  @db.VarChar(50)
  section     Section? @relation(fields: [sectionSlug], references: [slug], onDelete: SetNull)

  streamSlug String? @db.VarChar(50)
  stream     Stream? @relation(fields: [streamSlug], references: [slug], onDelete: SetNull)

  academicMappingSlug String?                                  @db.VarChar(50)
  academicMapping     StudentAcademicRollSectionStreamMapping? @relation(fields: [academicMappingSlug], references: [slug], onDelete: SetNull)

  attendanceDate DateTime @db.Date

  year  Int
  month Int
  day   Int

  attendanceStatus String @db.VarChar(10)

  markedBySlug String @db.VarChar(50)
  markedBy     User   @relation("AttendanceDayMarkedBy", fields: [markedBySlug], references: [slug], onDelete: Restrict)

  markedAt DateTime @default(now())

  isLocked Boolean @default(false)

  lockedBySlug String? @db.VarChar(50)
  lockedBy     User?   @relation("AttendanceDayLockedBy", fields: [lockedBySlug], references: [slug], onDelete: SetNull)

  lockedAt DateTime?

  unlockedBySlug String? @db.VarChar(50)
  unlockedBy     User?   @relation("AttendanceDayUnlockedBy", fields: [unlockedBySlug], references: [slug], onDelete: SetNull)

  unlockedAt DateTime?

  status    String    @default("active")
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attendanceSlug, attendanceDate])
  @@index([schoolSlug, attendanceDate])
  @@index([schoolSlug, sessionSlug, classSlug, sectionSlug, attendanceDate])
  @@index([studentSlug, attendanceDate])
  @@index([academicMappingSlug])
  @@map("student_attendance_days")
}

model StudentAttendanceLog {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  attendanceSlug String            @db.VarChar(50)
  attendance     StudentAttendance @relation(fields: [attendanceSlug], references: [slug], onDelete: Cascade)

  studentSlug String  @db.VarChar(50)
  student     Student @relation(fields: [studentSlug], references: [slug], onDelete: Cascade)

  sessionSlug String  @db.VarChar(50)
  session     Session @relation(fields: [sessionSlug], references: [slug], onDelete: Cascade)

  boardSlug String @db.VarChar(50)
  board     Board  @relation(fields: [boardSlug], references: [slug], onDelete: Cascade)

  classSlug String @db.VarChar(50)
  class     Class  @relation(fields: [classSlug], references: [slug], onDelete: Cascade)

  sectionSlug String?  @db.VarChar(50)
  section     Section? @relation(fields: [sectionSlug], references: [slug], onDelete: SetNull)

  streamSlug String? @db.VarChar(50)
  stream     Stream? @relation(fields: [streamSlug], references: [slug], onDelete: SetNull)

  academicMappingSlug String?                                  @db.VarChar(50)
  academicMapping     StudentAcademicRollSectionStreamMapping? @relation(fields: [academicMappingSlug], references: [slug], onDelete: SetNull)

  attendanceDate DateTime @db.Date

  year  Int
  month Int
  day   Int

  action AttendanceLogAction

  previousStatus String? @db.VarChar(10)
  currentStatus  String? @db.VarChar(10)

  previousData Json?
  currentData  Json?

  performedBySlug String @db.VarChar(50)
  performedBy     User   @relation("AttendanceLogPerformedBy", fields: [performedBySlug], references: [slug], onDelete: Restrict)

  performedAt DateTime @default(now())

  remarks   String? @db.VarChar(255)
  ipAddress String? @db.VarChar(100)
  userAgent String? @db.Text

  createdAt DateTime @default(now())

  @@index([attendanceSlug, attendanceDate])
  @@index([schoolSlug, attendanceDate])
  @@index([academicMappingSlug])
  @@index([schoolSlug, sessionSlug, classSlug, sectionSlug, attendanceDate])
  @@index([studentSlug, attendanceDate])
  @@index([performedBySlug, performedAt])
  @@index([action])
  @@map("student_attendance_logs")
}

enum AttendanceLogAction {
  CREATE
  UPDATE
  DELETE
  RESTORE
  LOCK
  UNLOCK
}

