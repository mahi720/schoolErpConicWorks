  deletedAt DateTime?

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  addSubjectToClass   AddSubjectToClass? @relation(fields: [addSubjectToClassId], references: [id])
  addSubjectToClassId Int?

  @@unique([schoolSlug, sessionSlug, boardSlug, classSlug, sectionSlug, fromDate, toDate], map: "uq_weekly_plan_period")
  @@index([schoolSlug, sessionSlug, boardSlug, classSlug], map: "idx_weekly_plan_filters")
  @@index([fromDate, toDate], map: "idx_weekly_plan_dates")
  @@map("weeklyPlans")
}

