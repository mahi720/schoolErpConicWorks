  hrmEmployeeLeaveRequests HrmEmployeeLeaveRequest[]
  hrmEmployeePayrollLeaves HrmEmployeePayrollLeave[]

  @@unique([schoolSlug, leaveType])
  @@index([schoolSlug])
  @@index([status])
  @@map("hrm_leave_types")
}

model HrmLoanInterest {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  durationMonths Int
  annualInterest Decimal @db.Decimal(6, 2)

  status    String    @default("active") @db.VarChar(20)
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  hrmEmployeeLoans HrmEmployeeLoan[]

  @@unique([schoolSlug, durationMonths])
  @@index([schoolSlug])
  @@index([status])
  @@map("hrm_loan_interests")
}

enum HrmLoanSalaryBasis {
  BASIC
  GROSS
}

model HrmLoanSetting {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @unique @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  eligibilityAfterMonths Int @default(6)

  salaryBasis HrmLoanSalaryBasis @default(GROSS)

  maximumSalaryMultiple Decimal @default(5) @db.Decimal(6, 2)

  minimumLoanAmount Decimal? @db.Decimal(12, 2)

  maximumLoanAmount Decimal? @db.Decimal(12, 2)

  allowMultipleLoan Boolean @default(false)

  approvalRequired Boolean @default(true)

  forecloseInterest Decimal @default(0) @db.Decimal(6, 2)

  status    String    @default("active") @db.VarChar(20)
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([status])
  @@map("hrm_loan_settings")
}
