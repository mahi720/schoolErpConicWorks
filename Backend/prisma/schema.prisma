  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  studentSlug String  @db.VarChar(50)
  student     Student @relation(fields: [studentSlug], references: [slug], onDelete: Cascade)

