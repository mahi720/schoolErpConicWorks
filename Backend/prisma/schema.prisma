  bankName          String? @db.VarChar(150)
  bankAccountNumber String? @db.VarChar(50)
  ifscCode          String? @db.VarChar(20)

  panNumber    String? @db.VarChar(20)
  uanNumber    String? @db.VarChar(30)
  aadharNumber String? @db.VarChar(20)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolSlug, bankAccountNumber])
  @@unique([schoolSlug, panNumber])
  @@unique([schoolSlug, uanNumber])
  @@unique([schoolSlug, aadharNumber])
  @@index([schoolSlug])
  @@index([employeeSlug])
  @@map("hrm_employee_bank_details")
}

model HrmEmployeeLoginSetting {
