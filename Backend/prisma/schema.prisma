model StudentPromotion {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  batchSlug String @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  studentSlug String  @db.VarChar(50)
  student     Student @relation(fields: [studentSlug], references: [slug], onDelete: Cascade)

  previousAcademicMappingSlug String                                  @db.VarChar(50)
  previousAcademicMapping     StudentAcademicRollSectionStreamMapping @relation("PreviousAcademicMappingPromotion", fields: [previousAcademicMappingSlug], references: [slug], onDelete: Restrict)

  newAcademicMappingSlug String                                  @db.VarChar(50)
  newAcademicMapping     StudentAcademicRollSectionStreamMapping @relation("NewAcademicMappingPromotion", fields: [newAcademicMappingSlug], references: [slug], onDelete: Restrict)

  previousSessionSlug String  @db.VarChar(50)
  previousSession     Session @relation("PreviousPromotionSession", fields: [previousSessionSlug], references: [slug], onDelete: Restrict)

  previousBoardSlug String @db.VarChar(50)
  previousBoard     Board  @relation("PreviousPromotionBoard", fields: [previousBoardSlug], references: [slug], onDelete: Restrict)

  previousClassSlug String @db.VarChar(50)
  previousClass     Class  @relation("PreviousPromotionClass", fields: [previousClassSlug], references: [slug], onDelete: Restrict)

  previousSectionSlug String?  @db.VarChar(50)
  previousSection     Section? @relation("PreviousPromotionSection", fields: [previousSectionSlug], references: [slug], onDelete: SetNull)

  previousStreamSlug String? @db.VarChar(50)
  previousStream     Stream? @relation("PreviousPromotionStream", fields: [previousStreamSlug], references: [slug], onDelete: SetNull)

  previousRollNumberPrefix String? @db.VarChar(20)
  previousRollNumber       Int?

  newSessionSlug String  @db.VarChar(50)
  newSession     Session @relation("NewPromotionSession", fields: [newSessionSlug], references: [slug], onDelete: Restrict)

  newBoardSlug String @db.VarChar(50)
  newBoard     Board  @relation("NewPromotionBoard", fields: [newBoardSlug], references: [slug], onDelete: Restrict)

  newClassSlug String @db.VarChar(50)
  newClass     Class  @relation("NewPromotionClass", fields: [newClassSlug], references: [slug], onDelete: Restrict)

  newSectionSlug String?  @db.VarChar(50)
  newSection     Section? @relation("NewPromotionSection", fields: [newSectionSlug], references: [slug], onDelete: SetNull)

  newStreamSlug String? @db.VarChar(50)
  newStream     Stream? @relation("NewPromotionStream", fields: [newStreamSlug], references: [slug], onDelete: SetNull)

  newRollNumberPrefix String? @db.VarChar(20)
  newRollNumber       Int?

  promotionType   PromotionType   @default(PROMOTED)
  promotionStatus PromotionStatus @default(COMPLETED)

  remarks String? @db.Text

  promotedAt DateTime @default(now())

  promotedBySlug String? @db.VarChar(50)
  promotedBy     User?   @relation("StudentPromotionApprovedBy", fields: [promotedBySlug], references: [slug], onDelete: SetNull)

  rolledBackAt DateTime?

  rolledBackBySlug String? @db.VarChar(50)
  rolledBackBy     User?   @relation("StudentPromotionRolledBackBy", fields: [rolledBackBySlug], references: [slug], onDelete: SetNull)

  rollbackRemarks String? @db.Text

  status    String    @default("active")
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolSlug, studentSlug, previousSessionSlug, newSessionSlug])
  @@index([batchSlug])
  @@index([schoolSlug])
  @@index([studentSlug])
  @@index([previousAcademicMappingSlug])
  @@index([newAcademicMappingSlug])
  @@index([previousSessionSlug])
  @@index([newSessionSlug])
  @@index([previousBoardSlug])
  @@index([newBoardSlug])
  @@index([previousClassSlug])
  @@index([newClassSlug])
  @@index([promotionType])
  @@index([promotionStatus])
  @@index([promotedAt])
  @@map("student_promotions")
}

enum PromotionType {
  PROMOTED
  DETAINED
  REPEATED
}

enum PromotionStatus {
  COMPLETED
  ROLLED_BACK
}

enum StudentAcademicStatus {
  CURRENT
  PROMOTED
  DETAINED
  REPEATED
  COMPLETED
  TRANSFERRED
}

