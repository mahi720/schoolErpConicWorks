model User {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  name     String
  email    String
  password String
  role     Role   @default(SUPER_ADMIN)

  schoolSlug String? @db.VarChar(50)
  school     School? @relation(fields: [schoolSlug], references: [slug])

  schoolCode String?

  weeklyPlans WeeklyPlan[]

  approvedStudentPromotions   StudentPromotion[] @relation("StudentPromotionApprovedBy")
  rolledBackStudentPromotions StudentPromotion[] @relation("StudentPromotionRolledBackBy")

  markedAttendanceDays   StudentAttendanceDay[] @relation("AttendanceDayMarkedBy")
  lockedAttendanceDays   StudentAttendanceDay[] @relation("AttendanceDayLockedBy")
  unlockedAttendanceDays StudentAttendanceDay[] @relation("AttendanceDayUnlockedBy")

  performedAttendanceLogs StudentAttendanceLog[] @relation("AttendanceLogPerformedBy")

  isActive     Boolean  @default(true)
  refreshToken String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submittedPeriodicTestMarks  PeriodicTestMarkSubmission[]  @relation("PeriodicTestMarkSubmittedBy")
  lockedPeriodicTestMarks     PeriodicTestMarkSubmission[]  @relation("PeriodicTestMarkLockedBy")
  periodicTestMarkAuditLogs   PeriodicTestMarkAuditLog[]    @relation("PeriodicTestMarkAuditPerformedBy")
  submittedTermExamMarks      TermExamMarkSubmission[]      @relation("TermExamMarkSubmittedBy")
  lockedTermExamMarks         TermExamMarkSubmission[]      @relation("TermExamMarkLockedBy")
  termExamMarkAuditLogs       TermExamMarkAuditLog[]        @relation("TermExamMarkAuditPerformedBy")
  submittedTopicWiseGrades    TopicWiseGradeSubmission[]    @relation("TopicWiseGradeSubmittedBy")
  lockedTopicWiseGrades       TopicWiseGradeSubmission[]    @relation("TopicWiseGradeLockedBy")
  topicWiseGradeAuditLogs     TopicWiseGradeAuditLog[]      @relation("TopicWiseGradeAuditPerformedBy")
  submittedCoScholasticGrades CoScholasticGradeSubmission[] @relation("CoScholasticGradeSubmittedBy")
  lockedCoScholasticGrades    CoScholasticGradeSubmission[] @relation("CoScholasticGradeLockedBy")
  coScholasticGradeAuditLogs  CoScholasticGradeAuditLog[]   @relation("CoScholasticGradeAuditPerformedBy")

  @@unique([email, schoolSlug])
  @@map("users")
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  STUDENT
  ACCOUNTANT
  LIBRARIAN
  HR
}

//session modal

model Session {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  name      String
  startDate DateTime
  endDate   DateTime
  status    String    @default("active")
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classMappings       ClassSectionStreamMapping[]
  addSubjectToClasses AddSubjectToClass[]

  admissionStudents Student[] @relation("AdmissionSession")
  currentStudents   Student[] @relation("CurrentSession")

  studentAcademicMappings StudentAcademicRollSectionStreamMapping[]

  studentPromotionsPrevious StudentPromotion[] @relation("PreviousPromotionSession")
  studentPromotionsNew      StudentPromotion[] @relation("NewPromotionSession")

  studentHealthAssessments StudentHealthAssessment[]
  studentAttendances       StudentAttendance[]
  studentAttendanceDays    StudentAttendanceDay[]
  studentAttendanceLogs    StudentAttendanceLog[]

  academicCalendars AcademicCalendar[]
  weeklyPlans       WeeklyPlan[]
  termExams         TermExam[]
  periodicTests     PeriodicTest[]

  @@unique([schoolSlug, name])
  @@map("sessions")
}

//board modal

model Board {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  title       String
  description String?
  status      String    @default("active")
  isActive    Boolean   @default(true)
  deletedAt   DateTime?

  classMappings       ClassSectionStreamMapping[]
  addSubjectToClasses AddSubjectToClass[]
  classes             Class[]
  sections            Section[]
  streams             Stream[]
  subjects            Subject[]
  feeTypes            FeeType[]
  students            Student[]

  studentAcademicMappings StudentAcademicRollSectionStreamMapping[]
  studentAttendances      StudentAttendance[]

  studentAttendanceDays StudentAttendanceDay[]
  studentAttendanceLogs StudentAttendanceLog[]
  termExams             TermExam[]

  studentPromotionsPrevious StudentPromotion[] @relation("PreviousPromotionBoard")
  studentPromotionsNew      StudentPromotion[] @relation("NewPromotionBoard")

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  weeklyPlans   WeeklyPlan[]
  periodicTests PeriodicTest[]

  @@unique([schoolSlug, title])
  @@map("boards")
}

//class modal

model Class {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  boardSlug String @db.VarChar(50)
  board     Board  @relation(fields: [boardSlug], references: [slug], onDelete: Cascade)

  classTitle String
  classType  String
  status     String    @default("active")
  isActive   Boolean   @default(true)
  deletedAt  DateTime?

  classMappings       ClassSectionStreamMapping[]
  addSubjectToClasses AddSubjectToClass[]
  admissionStudents   Student[]                   @relation("AdmissionClass")
  currentStudents     Student[]                   @relation("CurrentClass")

  studentAcademicMappings StudentAcademicRollSectionStreamMapping[]

  studentPromotionsPrevious StudentPromotion[]           @relation("PreviousPromotionClass")
  studentPromotionsNew      StudentPromotion[]           @relation("NewPromotionClass")
  weeklyPlans               WeeklyPlan[]
  studentAttendances        StudentAttendance[]
  studentAttendanceDays     StudentAttendanceDay[]
  studentAttendanceLogs     StudentAttendanceLog[]
  classConfigurations       TermExamClassConfiguration[]

  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  periodicTestClassConfigurations PeriodicTestClassConfiguration[]
  periodicTestMarkAuditLogs       PeriodicTestMarkAuditLog[]
  termExamMarkAuditLogs           TermExamMarkAuditLog[]
  topicWiseGradeAuditLogs         TopicWiseGradeAuditLog[]
  coScholasticGradeSubmissions    CoScholasticGradeSubmission[]
  coScholasticGradeAuditLogs      CoScholasticGradeAuditLog[]

  @@unique([schoolSlug, boardSlug, classTitle])
  @@map("classes")
}

//section modal

model Section {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  boardSlug String @db.VarChar(50)
  board     Board  @relation(fields: [boardSlug], references: [slug], onDelete: Cascade)

  sectionTitle String

  studentAcademicMappings StudentAcademicRollSectionStreamMapping[]

  studentAttendances    StudentAttendance[]
  studentAttendanceDays StudentAttendanceDay[]
  studentAttendanceLogs StudentAttendanceLog[]

  studentPromotionsPrevious StudentPromotion[] @relation("PreviousPromotionSection")
  studentPromotionsNew      StudentPromotion[] @relation("NewPromotionSection")

  weeklyPlans WeeklyPlan[]

  status    String    @default("active")
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  periodicTestMarkSubmissions  PeriodicTestMarkSubmission[]
  periodicTestMarkAuditLogs    PeriodicTestMarkAuditLog[]
  termExamMarkSubmissions      TermExamMarkSubmission[]
  termExamMarkAuditLogs        TermExamMarkAuditLog[]
  topicWiseGradeSubmissions    TopicWiseGradeSubmission[]
  topicWiseGradeAuditLogs      TopicWiseGradeAuditLog[]
  coScholasticGradeSubmissions CoScholasticGradeSubmission[]
  coScholasticGradeAuditLogs   CoScholasticGradeAuditLog[]

  @@unique([schoolSlug, boardSlug, sectionTitle])
  @@map("sections")
}

//stream modal

model Stream {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  boardSlug String @db.VarChar(50)
  board     Board  @relation(fields: [boardSlug], references: [slug], onDelete: Cascade)

  streamTitle String

  studentAcademicMappings StudentAcademicRollSectionStreamMapping[]

  studentPromotionsPrevious StudentPromotion[] @relation("PreviousPromotionStream")
  studentPromotionsNew      StudentPromotion[] @relation("NewPromotionStream")

  status    String    @default("active")
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  classSubjects          AddSubjectToClass[]
  studentAttendances     StudentAttendance[]
  studentAttendanceDays  StudentAttendanceDay[]
  studentAttendanceLogs  StudentAttendanceLog[]
  termExamTimeTables     TermExamTimeTable[]
  periodicTestTimeTables periodicTestTimeTable[]

  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  periodicTestMarkAuditLogs    PeriodicTestMarkAuditLog[]
  periodicTestMarkSubmissions  PeriodicTestMarkSubmission[]
  termExamMarkSubmissions      TermExamMarkSubmission[]
  termExamMarkAuditLogs        TermExamMarkAuditLog[]
  topicWiseGradeSubmissions    TopicWiseGradeSubmission[]
  topicWiseGradeAuditLogs      TopicWiseGradeAuditLog[]
  coScholasticGradeSubmissions CoScholasticGradeSubmission[]
  coScholasticGradeAuditLogs   CoScholasticGradeAuditLog[]

  @@unique([schoolSlug, boardSlug, streamTitle])
  @@map("streams")
}

//class section stream mapping modal

model ClassSectionStreamMapping {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  sessionSlug String  @db.VarChar(50)
  session     Session @relation(fields: [sessionSlug], references: [slug], onDelete: Cascade)

  boardSlug String @db.VarChar(50)
  board     Board  @relation(fields: [boardSlug], references: [slug], onDelete: Cascade)

  classSlug String @db.VarChar(50)
  class     Class  @relation(fields: [classSlug], references: [slug], onDelete: Cascade)

  sectionSlugs      Json
  streamSlugs       Json?
  classTeacherSlugs Json?

  startTime      String?
  endTime        String?
  periodDuration String?
  breakTime      String?
  breakDuration  String?

  status    String    @default("active")
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolSlug, sessionSlug, boardSlug, classSlug])
  @@map("class_section_stream_mappings")
}

//Subject modal

model Subject {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  boardSlug String @db.VarChar(50)
  board     Board  @relation(fields: [boardSlug], references: [slug], onDelete: Cascade)

  subjectTitle String
  subjectType  String
  subjectOrder Int

  status    String    @default("active")
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  classSubjects AddSubjectToClass[]

  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt
  coScholasticStudentSubjectGrades CoScholasticStudentSubjectGrade[]
  coScholasticGradeAuditLogs       CoScholasticGradeAuditLog[]

  @@unique([schoolSlug, boardSlug, subjectTitle])
  @@map("subjects")
}

//AddSubjectToClass modal

model AddSubjectToClass {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  sessionSlug String  @db.VarChar(50)
  session     Session @relation(fields: [sessionSlug], references: [slug], onDelete: Cascade)

  boardSlug String @db.VarChar(50)
  board     Board  @relation(fields: [boardSlug], references: [slug], onDelete: Cascade)

  classSlug String @db.VarChar(50)
  class     Class  @relation(fields: [classSlug], references: [slug], onDelete: Cascade)

  streamSlug String? @db.VarChar(50)
  stream     Stream? @relation(fields: [streamSlug], references: [slug], onDelete: SetNull)

  subjectSlug String  @db.VarChar(50)
  subject     Subject @relation(fields: [subjectSlug], references: [slug], onDelete: Cascade)

  studyType StudyType

  subjectTopics      SubjectTopic[]
  marksConfigs       SubjectMarksConfig[]
  termExamTimeTables TermExamTimeTable[]

  status    String    @default("active")
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt
  weeklyPlans                      WeeklyPlan[]
  periodicTestTimeTables           periodicTestTimeTable[]
  periodicTestMarkSubmissions      PeriodicTestMarkSubmission[]
  periodicTestMarkAuditLogs        PeriodicTestMarkAuditLog[]
  termExamMarkSubmissions          TermExamMarkSubmission[]
  termExamMarkAuditLogs            TermExamMarkAuditLog[]
  topicWiseGradeSubmissions        TopicWiseGradeSubmission[]
  topicWiseGradeAuditLogs          TopicWiseGradeAuditLog[]
  coScholasticStudentSubjectGrades CoScholasticStudentSubjectGrade[]
  coScholasticGradeAuditLogs       CoScholasticGradeAuditLog[]

  @@unique([schoolSlug, boardSlug, sessionSlug, classSlug, streamSlug, subjectSlug])
  @@map("add_subject_to_classes")
}

enum StudyType {
  THEORY
  PRACTICAL
  BOTH
}

// Subject Topic modal

model SubjectTopic {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  addedSubjectToClassSlug String            @db.VarChar(50)
  addedSubjectToClass     AddSubjectToClass @relation(fields: [addedSubjectToClassSlug], references: [slug], onDelete: Cascade)

  topicTitle String
  topicGroup String

  status    String    @default("active")
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  topicWiseStudentTopicGrades TopicWiseStudentTopicGrade[]
  topicWiseGradeAuditLogs     TopicWiseGradeAuditLog[]

  @@unique([addedSubjectToClassSlug, topicTitle, topicGroup])
  @@index([addedSubjectToClassSlug])
  @@index([status])
  @@map("subject_topics")
}

// Subject Marks Configuration modal

model SubjectMarksConfig {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  addedSubjectToClassSlug String            @db.VarChar(50)
  addedSubjectToClass     AddSubjectToClass @relation(fields: [addedSubjectToClassSlug], references: [slug], onDelete: Cascade)

  componentName String
  totalMarks    Int
  passingMarks  Int?

  status    String    @default("active")
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  termExamStudentComponentMarks TermExamStudentComponentMark[]

  @@unique([addedSubjectToClassSlug, componentName])
  @@index([addedSubjectToClassSlug])
  @@map("subject_marks_configs")
}

// Fee Type Modal

model FeeType {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  boardSlug String @db.VarChar(50)
  board     Board  @relation(fields: [boardSlug], references: [slug], onDelete: Cascade)

  feeType     String
  description String?

  status    String    @default("active")
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolSlug, feeType, boardSlug])
  @@index([schoolSlug, boardSlug])
  @@index([status])
  @@map("feeTypes")
}

// Remarks

model Remark {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  remarksTitle String

  status    String    @default("active")
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolSlug, remarksTitle])
  @@index([status])
  @@map("remarks")
}

// Payment Info modal

model PaymentInfo {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  primaryClientId   String?
  primaryMerchantId String?
  primarySecretKey  String? @db.Text

  otherClientId   String?
  otherMerchantId String?
  otherSecretKey  String? @db.Text

  status    String    @default("active")
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolSlug])
  @@map("payment_infos")
}

// Academic Module

// Student Admission

model Student {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  admissionNumber String   @db.VarChar(100)
  admissionDate   DateTime

  admissionSessionSlug String  @db.VarChar(50)
  admissionSession     Session @relation("AdmissionSession", fields: [admissionSessionSlug], references: [slug], onDelete: Cascade)

  currentSessionSlug String  @db.VarChar(50)
  currentSession     Session @relation("CurrentSession", fields: [currentSessionSlug], references: [slug], onDelete: Cascade)

  boardSlug String @db.VarChar(50)
  board     Board  @relation(fields: [boardSlug], references: [slug], onDelete: Cascade)

  admissionClassSlug String @db.VarChar(50)
  admissionClass     Class  @relation("AdmissionClass", fields: [admissionClassSlug], references: [slug], onDelete: Cascade)

  currentClassSlug String @db.VarChar(50)
  currentClass     Class  @relation("CurrentClass", fields: [currentClassSlug], references: [slug], onDelete: Cascade)

  sponsorshipType    String?
  sponsorshipRemarks String?

  studentName String
  fatherName  String
  motherName  String

  aadhaarNumber String?
  apaarId       String?
  penNumber     String?
  sats          String?

  dob          DateTime?
  placeOfBirth String?

  caste    String?
  category String?
  religion String?
  gender   String

  phone       String?
  motherPhone String?
  email       String?

  state    String?
  district String?
  city     String?
  address  String?

  motherTongue   String?
  secondLanguage String?
  bloodGroup     String?

  profileImage String?

  previousSchoolInfo PreviousSchoolInfo?
  health             StudentHealth?

  documents StudentDocument[]

  academicMapping StudentAcademicRollSectionStreamMapping[]

  promotions StudentPromotion[]

  healthAssessments     StudentHealthAssessment[]
  studentAttendances    StudentAttendance[]
  studentAttendanceDays StudentAttendanceDay[]
  studentAttendanceLogs StudentAttendanceLog[]

  otherInformation StudentOtherInformation?

  status    String    @default("active")
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  periodicTestStudentMarks   PeriodicTestStudentMark[]
  periodicTestMarkAuditLogs  PeriodicTestMarkAuditLog[]
  termExamStudentMarks       TermExamStudentMark[]
  termExamMarkAuditLogs      TermExamMarkAuditLog[]
  topicWiseStudentGrades     TopicWiseStudentGrade[]
  topicWiseGradeAuditLogs    TopicWiseGradeAuditLog[]
  coScholasticStudentGrades  CoScholasticStudentGrade[]
  coScholasticGradeAuditLogs CoScholasticGradeAuditLog[]

  @@unique([schoolSlug, admissionNumber])
  @@index([schoolSlug])
  @@index([currentSessionSlug])
  @@index([currentClassSlug])
  @@index([boardSlug])
  @@map("students")
}

// previous school info modal for students

model PreviousSchoolInfo {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  studentSlug String  @unique @db.VarChar(50)
  student     Student @relation(fields: [studentSlug], references: [slug], onDelete: Cascade)

  previousSchool String?
  schoolAddress  String?
  previousBoard  String?
  previousResult String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("previous_school_infos")
}

// student health 

model StudentHealth {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
