  @@index([academicMappingSlug], map: "idx_cssg_academic_mapping")
  @@map("co_scholastic_student_grades")
}

model CoScholasticStudentSubjectGrade {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  studentGradeSlug String                   @db.VarChar(50)
  studentGrade     CoScholasticStudentGrade @relation(fields: [studentGradeSlug], references: [slug], onDelete: Cascade)

  classSubjectSlug String            @db.VarChar(50)
  classSubject     AddSubjectToClass @relation(fields: [classSubjectSlug], references: [slug], onDelete: Cascade)

  subjectSlug String  @db.VarChar(50)
  subject     Subject @relation(fields: [subjectSlug], references: [slug], onDelete: Cascade)

  subjectTitle String @db.VarChar(191)
  subjectType  String @db.VarChar(100)
  subjectOrder Int    @default(0)

  grade CoScholasticGrade?

  assessmentStatus CoScholasticAssessmentStatus @default(ASSESSED)

  remarks String? @db.VarChar(500)

  status    String    @default("active")
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  auditLogs CoScholasticGradeAuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentGradeSlug, classSubjectSlug], map: "uq_co_scholastic_student_subject")
  @@index([schoolSlug], map: "idx_csssg_school")
  @@index([studentGradeSlug], map: "idx_csssg_student_grade")
  @@index([classSubjectSlug], map: "idx_csssg_class_subject")
  @@index([subjectSlug], map: "idx_csssg_subject")
  @@index([subjectType], map: "idx_csssg_subject_type")
  @@index([grade], map: "idx_csssg_grade")
  @@map("co_scholastic_student_subject_grades")
}

model CoScholasticGradeAuditLog {
  id   BigInt @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  submissionSlug String?                      @db.VarChar(50)
  submission     CoScholasticGradeSubmission? @relation(fields: [submissionSlug], references: [slug], onDelete: SetNull)

  studentGradeSlug String?                   @db.VarChar(50)
  studentGrade     CoScholasticStudentGrade? @relation(fields: [studentGradeSlug], references: [slug], onDelete: SetNull)

  studentSubjectGradeSlug String?                          @db.VarChar(50)
  studentSubjectGrade     CoScholasticStudentSubjectGrade? @relation(fields: [studentSubjectGradeSlug], references: [slug], onDelete: SetNull)

  termExamSlug String?   @db.VarChar(50)
  termExam     TermExam? @relation(fields: [termExamSlug], references: [slug], onDelete: SetNull)

  classSlug String? @db.VarChar(50)
  class     Class?  @relation(fields: [classSlug], references: [slug], onDelete: SetNull)

  classSubjectSlug String?            @db.VarChar(50)
  classSubject     AddSubjectToClass? @relation(fields: [classSubjectSlug], references: [slug], onDelete: SetNull)

  subjectSlug String?  @db.VarChar(50)
  subject     Subject? @relation(fields: [subjectSlug], references: [slug], onDelete: SetNull)

  sectionSlug String?  @db.VarChar(50)
  section     Section? @relation(fields: [sectionSlug], references: [slug], onDelete: SetNull)

  streamSlug String? @db.VarChar(50)
  stream     Stream? @relation(fields: [streamSlug], references: [slug], onDelete: SetNull)

  studentSlug String?  @db.VarChar(50)
  student     Student? @relation(fields: [studentSlug], references: [slug], onDelete: SetNull)

  performedBySlug String? @db.VarChar(50)
  performedBy     User?   @relation("CoScholasticGradeAuditPerformedBy", fields: [performedBySlug], references: [slug], onDelete: SetNull)

  action CoScholasticGradeAuditAction
  result CoScholasticGradeAuditResult @default(SUCCESS)

  actorName  String? @db.VarChar(150)
  actorEmail String? @db.VarChar(191)
  actorRole  String? @db.VarChar(50)

  termExamTitle String? @db.VarChar(191)
  academicYear  String? @db.VarChar(50)
  boardTitle    String? @db.VarChar(100)
  classTitle    String? @db.VarChar(100)
  sectionTitle  String? @db.VarChar(100)
  streamTitle   String? @db.VarChar(100)

  subjectTitle String? @db.VarChar(191)
  subjectType  String? @db.VarChar(100)

  studentName     String? @db.VarChar(191)
  admissionNumber String? @db.VarChar(100)
  rollNumber      Int?

  previousGrade CoScholasticGrade?
  newGrade      CoScholasticGrade?

  previousAssessmentStatus CoScholasticAssessmentStatus?
  newAssessmentStatus      CoScholasticAssessmentStatus?

  previousRemarkType String? @db.VarChar(100)
  newRemarkType      String? @db.VarChar(100)

  previousRemark String? @db.VarChar(1000)
  newRemark      String? @db.VarChar(1000)

  previousPresentDays Int?
  newPresentDays      Int?

  previousTotalDays Int?
  newTotalDays      Int?

  previousResult CoScholasticStudentResult?
  newResult      CoScholasticStudentResult?

  previousIsLocked Boolean?
  newIsLocked      Boolean?

  remarks String? @db.VarChar(500)

  oldData       Json?
  newData       Json?
  changedFields Json?
  requestBody   Json?

  ipAddress        String? @db.VarChar(100)
  forwardedFor     String? @db.VarChar(500)
  userAgent        String? @db.Text
  requestMethod    String? @db.VarChar(10)
  requestUrl       String? @db.Text
  requestId        String? @db.VarChar(100)
  deviceIdentifier String? @db.VarChar(191)

  errorMessage String? @db.Text

  createdAt DateTime @default(now())

  @@index([schoolSlug], map: "idx_csgal_school")
  @@index([submissionSlug], map: "idx_csgal_submission")
  @@index([studentGradeSlug], map: "idx_csgal_student_grade")
  @@index([studentSubjectGradeSlug], map: "idx_csgal_student_subject_grade")
  @@index([termExamSlug], map: "idx_csgal_term_exam")
  @@index([classSlug], map: "idx_csgal_class")
  @@index([classSubjectSlug], map: "idx_csgal_class_subject")
  @@index([subjectSlug], map: "idx_csgal_subject")
  @@index([sectionSlug], map: "idx_csgal_section")
  @@index([streamSlug], map: "idx_csgal_stream")
  @@index([studentSlug], map: "idx_csgal_student")
  @@index([performedBySlug], map: "idx_csgal_performed_by")
  @@index([action], map: "idx_csgal_action")
  @@index([result], map: "idx_csgal_result")
  @@index([createdAt], map: "idx_csgal_created_at")
  @@index([schoolSlug, studentSlug, createdAt], map: "idx_csgal_student_history")
  @@map("co_scholastic_grade_audit_logs")
}

enum CoScholasticGradeAuditResult {
  SUCCESS
  FAILED
}

enum CoScholasticGradeAuditAction {
  CREATE_SUBMISSION
  SAVE_GRADES
  UPDATE_GRADES
  BULK_UPDATE_GRADES
  SAVE_SUBJECT_GRADE
  UPDATE_SUBJECT_GRADE
  SAVE_REMARK
  UPDATE_REMARK
  UPDATE_ATTENDANCE_SUMMARY
  UPDATE_RESULT
  MARK_ASSESSED
  MARK_ABSENT
  MARK_EXEMPTED
  MARK_NOT_ASSESSED
  LOCK_GRADES
  UNLOCK_GRADES
  DELETE_GRADES
  RESTORE_GRADES
  VIEW_GRADES
  GENERATE_PDF
}
