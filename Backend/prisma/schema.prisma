// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Master module
// school modal

model School {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolName         String
  schoolCode         String  @unique @db.VarChar(50)
  affiliationNumber  String?
  registrationNumber String?

  contactPersonName String
  contactNumber     String
  contactEmail      String

  addressLine1 String
  addressLine2 String?
  city         String
  district     String
  state        String
  country      String  @default("India")
  pinCode      String

  logo    String?
  website String?

  lectureCount     Int?
  teachingSaturday Boolean @default(false)
  classrooms       Int?

  plan          SchoolPlan @default(BASIC)
  planStartDate DateTime?
  planEndDate   DateTime?
  maxStudents   Int?
  maxUsers      Int?

  status    String    @default("active")
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  users                       User[]
  sessions                    Session[]
  boards                      Board[]
  classes                     Class[]
  sections                    Section[]
  streams                     Stream[]
  classMappings               ClassSectionStreamMapping[]
  subjects                    Subject[]
  addSubjectToClasses         AddSubjectToClass[]
  feeTypes                    FeeType[]
  remarks                     Remark[]
  paymentInfo                 PaymentInfo?
  students                    Student[]
  studentHealths              StudentHealth[]
  studentVaccinations         StudentVaccination[]
  studentDocuments            StudentDocument[]
  studentAcademicMappings     StudentAcademicRollSectionStreamMapping[]
  studentPromotions           StudentPromotion[]
  studentHealthAssessments    StudentHealthAssessment[]
  studentOtherInformations    StudentOtherInformation[]
  academicCalendars           AcademicCalendar[]
  weeklyPlans                 WeeklyPlan[]
  weeklyPlanLessons           WeeklyPlanLesson[]
  studentAttendances          StudentAttendance[]
  studentAttendanceDays       StudentAttendanceDay[]
  studentAttendanceLogs       StudentAttendanceLog[]
  examTypes                   ExamType[]
  termExams                   TermExam[]
  termExamClassConfigurations TermExamClassConfiguration[]
  termExamTimeTables          TermExamTimeTable[]

  createdAt                        DateTime                          @default(now())
  updatedAt                        DateTime                          @updatedAt
  periodicTests                    PeriodicTest[]
  periodicTestTimeTables           periodicTestTimeTable[]
  periodicTestClassConfigurations  PeriodicTestClassConfiguration[]
  periodicTestMarkSubmissions      PeriodicTestMarkSubmission[]
  periodicTestStudentMarks         PeriodicTestStudentMark[]
  periodicTestMarkAuditLogs        PeriodicTestMarkAuditLog[]
  termExamMarkSubmissions          TermExamMarkSubmission[]
  termExamStudentMarks             TermExamStudentMark[]
  termExamStudentComponentMarks    TermExamStudentComponentMark[]
  termExamMarkAuditLogs            TermExamMarkAuditLog[]
  topicWiseGradeSubmissions        TopicWiseGradeSubmission[]
  topicWiseStudentGrades           TopicWiseStudentGrade[]
  topicWiseStudentTopicGrades      TopicWiseStudentTopicGrade[]
  topicWiseGradeAuditLogs          TopicWiseGradeAuditLog[]
  coScholasticGradeSubmissions     CoScholasticGradeSubmission[]
  coScholasticStudentGrades        CoScholasticStudentGrade[]
  coScholasticStudentSubjectGrades CoScholasticStudentSubjectGrade[]
  coScholasticGradeAuditLogs       CoScholasticGradeAuditLog[]

  @@map("schools")
}

enum SchoolPlan {
  BASIC
  STANDARD
  PREMIUM
  ENTERPRISE
}

