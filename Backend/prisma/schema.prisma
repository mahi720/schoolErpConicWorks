model HrmEmployee {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

  schoolSlug String @db.VarChar(50)
  school     School @relation(fields: [schoolSlug], references: [slug], onDelete: Cascade)

  userSlug String? @unique @db.VarChar(50)
  user     User?   @relation(fields: [userSlug], references: [slug], onDelete: SetNull)

  employeeId     String  @db.VarChar(50)
  employeeSerial Int
  employeeCode   String? @db.VarChar(50)

  fullName String  @db.VarChar(150)
  nickName String? @db.VarChar(100)

  phoneNumber String @db.VarChar(20)
  email       String @db.VarChar(191)

  dateOfBirth DateTime?

  state    String? @db.VarChar(100)
  city     String? @db.VarChar(100)
  district String? @db.VarChar(100)
  pincode  String? @db.VarChar(10)
  address  String? @db.Text

  qualification String? @db.Text

  departmentSlug String
  department     HrmDepartment @relation(fields: [departmentSlug], references: [slug], onDelete: Restrict)

  designationSlug String
  designation     HrmDesignation @relation(fields: [designationSlug], references: [slug], onDelete: Restrict)

  natureOfAppointment HrmNatureOfAppointment

  payBandSlug String
  payBand     HrmPayBand @relation(fields: [payBandSlug], references: [slug], onDelete: Restrict)

  joiningDate DateTime

  bankDetail   HrmEmployeeBankDetail?
  loginSetting HrmEmployeeLoginSetting?

  jobRoleDescription String? @db.Text

  isDrfApplicable Boolean @default(false)

  employmentStatus HrmEmployeeEmploymentStatus @default(ACTIVE)

  transferGroupSlug String? @db.VarChar(50)
  transferSequence  Int     @default(1)

  previousEmployeeSlug String? @db.VarChar(50)

  isTransferred Boolean   @default(false)
  transferredAt DateTime?

  status    String    @default("active") @db.VarChar(20)
  isActive  Boolean   @default(true)
  deletedAt DateTime?

  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  hrmEmployeeSalaryStructure     HrmEmployeeSalaryStructure?
  hrmEmployeeSalaryIncrements    HrmEmployeeSalaryIncrement[]
  hrmHolidays                    HrmHoliday[]
  hrmHolidayAssignments          HrmHolidayAssignment[]
  hrmEmployeeAttendances         HrmEmployeeAttendance[]
  hrmEmployeeAttendanceLogs      HrmEmployeeAttendanceLog[]
  hrmEmployeeLeaveRequests       HrmEmployeeLeaveRequest[]
  hrmEmployeeLeaveRequestLogs    HrmEmployeeLeaveRequestLog[]
  overtimeRequests               HrmOvertimeRequest[]            @relation("HrmOvertimeEmployee")
  appointedOvertimeRequests      HrmOvertimeRequest[]            @relation("HrmOvertimeAppointedBy")
  hrmEmployeeAdvances            HrmEmployeeAdvance[]
  hrmEmployeeAdvanceInstallments HrmEmployeeAdvanceInstallment[]
  hrmEmployeeLoans               HrmEmployeeLoan[]               @relation("HrmEmployeeLoans")
  hrmEmployeeLoanInstallments    HrmEmployeeLoanInstallment[]    @relation("HrmEmployeeLoanInstallments")
  hrmEmployeePayrollLogs         HrmEmployeePayrollLog[]
  hrmEmployeePayrolls            HrmEmployeePayroll[]

  @@index([schoolSlug])
  @@index([userSlug])
  @@index([departmentSlug])
  @@index([designationSlug])
  @@index([payBandSlug])
  @@index([natureOfAppointment])
  @@index([employmentStatus])
  @@index([status])
  @@index([schoolSlug, employeeId])
  @@index([schoolSlug, employeeSerial])
  @@index([schoolSlug, employeeCode])
  @@index([schoolSlug, email])
  @@index([schoolSlug, phoneNumber])
  @@index([schoolSlug, transferGroupSlug])
  @@index([schoolSlug, isTransferred])
  @@map("hrm_employees")
}

model HrmEmployeeBankDetail {
  id   Int    @id @default(autoincrement())
  slug String @unique @db.VarChar(50)

